    },
    "evidence_basis": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expected_refusal_or_guardrail": {
      "type": "string"
    },
    "prompt_or_scenario": {
      "type": "string"
    },
    "risk_category": {
      "type": "string"
    }
  },
  "required": [
